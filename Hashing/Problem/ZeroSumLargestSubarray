-----------Prefix Sum ---------------

#include<bits/stdc++.h>
class Solution {
  public:
    int maxLength(vector<int>& arr) {
        // code here
        // Prefix Sum
        
        unordered_map<int, int>m;
        
        int sum = 0, ans = 0;
        
        for(int j=0; j<arr.size(); j++){
            sum += arr[j];
            
            if(sum == 0)
                ans = j + 1; //corner case {1, -1}
            
            if(m.count(sum)){
                int currLen = j - m[sum];
                ans = max(ans, currLen );
            }else{
                m[sum] = j;
            }
        }
        
        return ans;
    }
};